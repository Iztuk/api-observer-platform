{
  "name": "api-observer",
  "version": "1.0.0",
  "description": "API Observer is a self-hosted API observability platform that monitors and evaluates HTTP traffic against OpenAPI contracts and custom security rules. It produces structured findings that help developers identify unexpected behavior, contract violations, and potential security concerns.",
