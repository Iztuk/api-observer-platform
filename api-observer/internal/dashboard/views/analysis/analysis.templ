package analysis

import "api-observer/internal/dashboard/views"

templ AnalysisPage(
	title string,
	queryString string,
	start string,
	end string,
) {
	@views.Layout(title) {
		<link
			rel="stylesheet"
			href="/static/css/analysis.css"
		/>
		<link
			rel="stylesheet"
			href="/static/js/monaco.css"
		/>
		@AnalysisPageContent(
			queryString,
			start,
			end,
		)
		<script type="module" src="/static/js/monaco.js"></script>
		@AnalysisStreamScript()
	}
}

templ AnalysisPageContent(
	queryString string,
	start string,
	end string,
) {
	<div class="analysis-page">
		<form
			id="analysis-form"
			class="analysis-form"
		>
			<div class="analysis-search">
				<input
					type="search"
					id="analysis-query"
					name="query"
					value={ queryString }
					placeholder="Search logs..."
					aria-label="Search logs"
				/>
				<button
					type="submit"
					class="analysis-search-button"
					aria-label="Search"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<circle
							cx="11"
							cy="11"
							r="8"
						></circle>
						<line
							x1="21"
							y1="21"
							x2="16.65"
							y2="16.65"
						></line>
					</svg>
					<span>
						Search
					</span>
				</button>
			</div>
			<details class="analysis-advanced">
				<summary>
					<span>
						Advanced Settings
					</span>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="m6 9 6 6 6-6"></path>
					</svg>
				</summary>
				<div class="analysis-filters">
					<div class="analysis-filter">
						<label for="analysis-start">
							Start Date
						</label>
						<input
							type="datetime-local"
							id="analysis-start"
							name="start"
							value={ start }
						/>
					</div>
					<div class="analysis-filter">
						<label for="analysis-end">
							End Date
						</label>
						<input
							type="datetime-local"
							id="analysis-end"
							name="end"
							value={ end }
						/>
					</div>
				</div>
			</details>
			<textarea
				id="analysis-rules"
				name="rules"
				hidden
			>rules:</textarea>
		</form>
		<div class="analysis-toolbar">
			<div
				class="analysis-view-switcher"
				role="tablist"
				aria-label="Analysis view"
			>
				<button
					id="analysis-logs-tab"
					type="button"
					class="analysis-view-tab active"
					role="tab"
					aria-selected="true"
					aria-controls="analysis-results"
				>
					Logs
				</button>
				<button
					id="analysis-rules-tab"
					type="button"
					class="analysis-view-tab"
					role="tab"
					aria-selected="false"
					aria-controls="analysis-editor"
				>
					Rules
				</button>
			</div>
		</div>
		<div class="analysis-workspace">
			<section
				id="analysis-results"
				class="analysis-results"
			>
				<div
					id="analysis-stream-status"
					class="analysis-stream-status"
				>
					Ready
				</div>
				<div
					id="analysis-table-container"
					class="analysis-table-container"
				>
					<table class="analysis-table">
						<thead>
							<tr>
								<th></th>
								<th>Timestamp</th>
								<th>Node</th>
								<th>Type</th>
								<th>Method</th>
								<th>Path</th>
								<th>Status</th>
								<th>Findings</th>
							</tr>
						</thead>
						<tbody id="analysis-log-body">
							<tr id="analysis-empty-row">
								<td
									colspan="8"
									class="analysis-empty"
								>
									Search to analyze logs.
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>
			<section
				id="analysis-editor"
				class="analysis-editor"
				hidden
			>
				<div class="analysis-editor-header">
					<div>
						<h2>
							Rule Set
						</h2>
						<p>
							These rules are applied to each streamed log record.
						</p>
					</div>
				</div>
				<div class="analysis-editor-content">
					<div
						id="analysis-rules-editor"
						class="api-observer-editor analysis-monaco-editor"
						data-language="yaml"
					></div>
				</div>
			</section>
		</div>
	</div>
}

templ AnalysisStreamScript() {
	<script>
		(() => {
			const form = document.getElementById("analysis-form");

			const body = document.getElementById("analysis-log-body");

			const container = document.getElementById("analysis-table-container");

			const results = document.getElementById("analysis-results");

			const editorSection = document.getElementById("analysis-editor");

			const rulesEditorElement = document.getElementById(
				"analysis-rules-editor",
			);

			const rulesInput = document.getElementById("analysis-rules");

			const logsTab = document.getElementById("analysis-logs-tab");

			const rulesTab = document.getElementById("analysis-rules-tab");

			const statusElement = document.getElementById("analysis-stream-status");

			if (
				!form ||
				!body ||
				!container ||
				!results ||
				!editorSection ||
				!rulesEditorElement ||
				!rulesInput
			) {
				return;
			}

			/*
			 * Keep this synchronized with analysis.css.
			 */
			const rowHeight = 48;

			/*
			 * Number of rows rendered outside the
			 * visible viewport.
			 */
			const overscan = 20;

			/*
			 * Complete set of analysis results.
			 *
			 * Only a small window from this array is
			 * represented in the DOM.
			 */
			const logs = [];

			/*
			 * Expansion state lives outside the DOM
			 * so it survives virtual scrolling.
			 */
			const expandedRows = new Set();

			let controller = null;

			let rulesEditor = null;

			let completedNodes = 0;

			let failedNodes = 0;

			let renderPending = false;

			/*
			 * Range currently represented by actual
			 * DOM rows.
			 */
			let renderedStart = -1;

			let renderedEnd = -1;

			const initializeRulesEditor = () => {
				if (rulesEditor || !window.monaco) {
					return;
				}

				rulesEditor = window.monaco.editor.create(rulesEditorElement, {
					value: rulesInput.value,

					language: "yaml",

					automaticLayout: true,

					minimap: {
						enabled: false,
					},

					scrollBeyondLastLine: false,

					wordWrap: "off",

					tabSize: 2,
				});

				rulesEditor.onDidChangeModelContent(() => {
					rulesInput.value = rulesEditor.getValue();
				});
			};

			if (window.monaco) {
				initializeRulesEditor();
			} else {
				window.addEventListener("monaco:ready", initializeRulesEditor, {
					once: true,
				});
			}

			const showResults = () => {
				results.hidden = false;

				editorSection.hidden = true;

				if (logsTab) {
					logsTab.classList.add("active");

					logsTab.setAttribute("aria-selected", "true");
				}

				if (rulesTab) {
					rulesTab.classList.remove("active");

					rulesTab.setAttribute("aria-selected", "false");
				}

				/*
				 * The table may have changed size while
				 * hidden. Recalculate its virtual window.
				 */
				requestAnimationFrame(() => {
					scheduleRender(true);
				});
			};

			const showEditor = () => {
				results.hidden = true;

				editorSection.hidden = false;

				if (logsTab) {
					logsTab.classList.remove("active");

					logsTab.setAttribute("aria-selected", "false");
				}

				if (rulesTab) {
					rulesTab.classList.add("active");

					rulesTab.setAttribute("aria-selected", "true");
				}

				initializeRulesEditor();

				if (rulesEditor) {
					requestAnimationFrame(() => {
						rulesEditor.layout();
					});
				}
			};

			if (logsTab) {
				logsTab.addEventListener("click", showResults);
			}

			if (rulesTab) {
				rulesTab.addEventListener("click", showEditor);
			}

			const updateStatus = (message) => {
				if (!statusElement) {
					return;
				}

				statusElement.textContent = message;
			};

			const createCell = (value) => {
				const cell = document.createElement("td");

				if (value !== undefined && value !== null) {
					const text = String(value);

					cell.textContent = text;

					/*
					 * Keep rows one line high for
					 * virtualization while still allowing
					 * the full value to be inspected.
					 */
					cell.title = text;
				}

				return cell;
			};

			const createDetailField = (label, value) => {
				const field = document.createElement("div");

				field.className = "analysis-detail-field";

				const labelElement = document.createElement("span");

				labelElement.className = "analysis-detail-label";

				labelElement.textContent = label;

				const valueElement = document.createElement("span");

				valueElement.className = "analysis-detail-value";

				valueElement.textContent = value ?? "";

				field.append(labelElement, valueElement);

				return field;
			};

			const createFinding = (finding) => {
				const findingElement = document.createElement("div");

				findingElement.className = "analysis-finding";

				if (finding.severity) {
					findingElement.dataset.severity = finding.severity;
				}

				const fields = document.createElement("div");

				fields.className = "analysis-finding-fields";

				fields.append(
					createDetailField("Title", finding.title || "Finding"),

					createDetailField("Severity", finding.severity || "Unknown"),

					createDetailField("Message", finding.message || ""),
				);

				if (Array.isArray(finding.tags) && finding.tags.length > 0) {
					fields.append(createDetailField("Tags", finding.tags.join(", ")));
				}

				findingElement.append(fields);

				return findingElement;
			};

			const createDetailsRow = (log) => {
				const detailsRow = document.createElement("tr");

				detailsRow.className = "analysis-log-details-row";

				const cell = document.createElement("td");

				cell.colSpan = 8;

				const details = document.createElement("div");

				details.className = "analysis-log-details";

				const findings = Array.isArray(log.findings) ? log.findings : [];

				const findingsSection = document.createElement("div");

				findingsSection.className = "analysis-findings";

				const title = document.createElement("div");

				title.className = "analysis-findings-title";

				title.textContent = "Findings (" + findings.length + ")";

				findingsSection.append(title);

				if (findings.length === 0) {
					const empty = document.createElement("div");

					empty.className = "analysis-findings-empty";

					empty.textContent = "No findings for this log.";

					findingsSection.append(empty);
				} else {
					for (const finding of findings) {
						findingsSection.append(createFinding(finding));
					}
				}

				details.append(findingsSection);

				cell.append(details);

				detailsRow.append(cell);

				return detailsRow;
			};

			const createSpacerRow = (height) => {
				const row = document.createElement("tr");

				row.className = "analysis-spacer-row";

				const cell = document.createElement("td");

				cell.colSpan = 8;

				cell.style.height = Math.max(0, height) + "px";

				row.append(cell);

				return row;
			};

			const createLogRow = (log, index) => {
				const findings = Array.isArray(log.findings) ? log.findings : [];

				const expanded = expandedRows.has(index);

				const row = document.createElement("tr");

				row.className = "analysis-log-row";

				row.dataset.index = String(index);

				row.tabIndex = 0;

				row.setAttribute("role", "button");

				row.setAttribute("aria-expanded", expanded ? "true" : "false");

				const timestamp = log.timestamp
					? new Date(log.timestamp).toLocaleString()
					: "";

				const toggleCell = document.createElement("td");

				toggleCell.className = "analysis-toggle-cell";

				const rowToggle = document.createElement("span");

				rowToggle.className = "analysis-row-toggle";

				rowToggle.textContent = expanded ? "⌄" : "›";

				toggleCell.append(rowToggle);

				row.append(
					toggleCell,

					createCell(timestamp),

					createCell(log.node_name || ""),

					createCell(log.type || ""),

					createCell(log.method || ""),

					createCell(log.path || ""),

					createCell(log.status ?? ""),

					createCell(findings.length),
				);

				const toggleDetails = () => {
					if (expandedRows.has(index)) {
						expandedRows.delete(index);
					} else {
						expandedRows.add(index);
					}

					/*
					 * Expansion changes the DOM
					 * structure, so force the
					 * current virtual range to
					 * rebuild.
					 */
					scheduleRender(true);
				};

				row.addEventListener("click", toggleDetails);

				row.addEventListener("keydown", (event) => {
					if (event.key === "Enter" || event.key === " ") {
						event.preventDefault();

						toggleDetails();
					}
				});

				return row;
			};

			const getRenderWindow = () => {
				const scrollTop = container.scrollTop;

				const viewportHeight = container.clientHeight;

				const visibleStart = Math.floor(scrollTop / rowHeight);

				const visibleCount = Math.ceil(viewportHeight / rowHeight);

				const startIndex = Math.max(0, visibleStart - overscan);

				const endIndex = Math.min(
					logs.length,
					visibleStart + visibleCount + overscan,
				);

				return {
					startIndex,
					endIndex,
				};
			};

			const updateSpacerHeights = (startIndex, endIndex) => {
				const topSpacer = body.querySelector(
					".analysis-spacer-row[data-position='top']",
				);

				const bottomSpacer = body.querySelector(
					".analysis-spacer-row[data-position='bottom']",
				);

				const topHeight = startIndex * rowHeight;

				const bottomHeight = Math.max(0, (logs.length - endIndex) * rowHeight);

				if (topSpacer && topSpacer.firstElementChild) {
					topSpacer.firstElementChild.style.height =
						Math.max(0, topHeight) + "px";
				}

				if (bottomSpacer && bottomSpacer.firstElementChild) {
					bottomSpacer.firstElementChild.style.height =
						Math.max(0, bottomHeight) + "px";
				}
			};

			const render = (force = false) => {
				renderPending = false;

				if (logs.length === 0) {
					return;
				}

				const { startIndex, endIndex } = getRenderWindow();

				/*
				 * This is what prevents streaming
				 * batches from causing hovered rows
				 * to flash.
				 *
				 * If the current virtual range is
				 * unchanged, preserve all visible DOM
				 * nodes and only update spacer height.
				 */
				if (
					!force &&
					startIndex === renderedStart &&
					endIndex === renderedEnd
				) {
					updateSpacerHeights(startIndex, endIndex);

					return;
				}

				const topHeight = startIndex * rowHeight;

				const bottomHeight = Math.max(0, (logs.length - endIndex) * rowHeight);

				const fragment = document.createDocumentFragment();

				/*
				 * Keep spacer rows present even when
				 * their height is zero.
				 *
				 * That allows future streamed batches
				 * to update them without rebuilding
				 * the visible rows.
				 */
				const topSpacer = createSpacerRow(topHeight);

				topSpacer.dataset.position = "top";

				fragment.append(topSpacer);

				for (let index = startIndex; index < endIndex; index++) {
					const log = logs[index];

					fragment.append(createLogRow(log, index));

					/*
					 * Details aren't created at all
					 * unless this row is expanded.
					 */
					if (expandedRows.has(index)) {
						fragment.append(createDetailsRow(log));
					}
				}

				const bottomSpacer = createSpacerRow(bottomHeight);

				bottomSpacer.dataset.position = "bottom";

				fragment.append(bottomSpacer);

				body.replaceChildren(fragment);

				renderedStart = startIndex;

				renderedEnd = endIndex;
			};

			const scheduleRender = (force = false) => {
				if (renderPending) {
					return;
				}

				renderPending = true;

				requestAnimationFrame(() => {
					render(force);
				});
			};

			const clearResults = () => {
				logs.length = 0;

				expandedRows.clear();

				renderedStart = -1;

				renderedEnd = -1;

				container.scrollTop = 0;

				const row = document.createElement("tr");

				row.id = "analysis-empty-row";

				const cell = document.createElement("td");

				cell.colSpan = 8;

				cell.className = "analysis-empty";

				cell.textContent = "Loading logs...";

				row.append(cell);

				body.replaceChildren(row);

				completedNodes = 0;

				failedNodes = 0;
			};

			container.addEventListener(
				"scroll",
				() => {
					scheduleRender();
				},
				{
					passive: true,
				},
			);

			const closeStream = () => {
				if (!controller) {
					return;
				}

				controller.abort();

				controller = null;
			};

			const handleSSEEvent = (eventName, data) => {
				switch (eventName) {
					case "logs": {
						let incoming;

						try {
							incoming = JSON.parse(data);
						} catch (error) {
							console.error("Failed to parse Analysis logs:", error);

							break;
						}

						if (!Array.isArray(incoming)) {
							console.error("Invalid Analysis logs payload:", incoming);

							break;
						}

						/*
						 * Store data rather than creating
						 * DOM nodes for every record.
						 */
						logs.push(...incoming);

						scheduleRender();

						updateStatus("Analyzing logs — " + logs.length + " matches");

						break;
					}

					case "node_done": {
						completedNodes++;

						const nodeLabel =
							completedNodes === 1 ? "node complete" : "nodes complete";

						updateStatus(
							"Analyzing logs — " +
								logs.length +
								" matches, " +
								completedNodes +
								" " +
								nodeLabel,
						);

						break;
					}

					case "node_error": {
						let result;

						try {
							result = JSON.parse(data);
						} catch (error) {
							console.error("Failed to parse Analysis node error:", error);

							break;
						}

						failedNodes++;

						console.error(
							"Analysis stream failed:",
							result.node_name || result.node_id,
							result.message,
						);

						const errorLabel = failedNodes === 1 ? "node error" : "node errors";

						updateStatus(
							"Analyzing logs — " +
								logs.length +
								" matches, " +
								failedNodes +
								" " +
								errorLabel,
						);

						break;
					}

					case "done": {
						let result;

						try {
							result = JSON.parse(data);
						} catch (error) {
							console.error("Failed to parse Analysis done event:", error);

							break;
						}

						if (logs.length === 0) {
							const row = document.createElement("tr");

							row.id = "analysis-empty-row";

							const cell = document.createElement("td");

							cell.colSpan = 8;

							cell.className = "analysis-empty";

							cell.textContent = "No logs found.";

							row.append(cell);

							body.replaceChildren(row);

							renderedStart = -1;

							renderedEnd = -1;
						} else {
							scheduleRender();
						}

						const nodeLabel = result.completed_nodes === 1 ? "node" : "nodes";

						let message =
							"Complete — " +
							result.matches +
							" matches across " +
							result.completed_nodes +
							" " +
							nodeLabel;

						if (result.failed_nodes > 0) {
							message += " (" + result.failed_nodes + " failed)";
						}

						updateStatus(message);

						break;
					}
				}
			};

			const consumeSSEStream = async (response) => {
				if (!response.body) {
					throw new Error("streaming response body is unavailable");
				}

				const reader = response.body.getReader();

				const decoder = new TextDecoder();

				let buffer = "";

				while (true) {
					const { value, done } = await reader.read();

					if (done) {
						break;
					}

					buffer += decoder.decode(value, {
						stream: true,
					});

					const events = buffer.split("\n\n");

					buffer = events.pop() ?? "";

					for (const rawEvent of events) {
						if (!rawEvent.trim()) {
							continue;
						}

						let eventName = "message";

						let data = "";

						for (const line of rawEvent.split("\n")) {
							if (line.startsWith("event:")) {
								eventName = line.slice(6).trim();

								continue;
							}

							if (line.startsWith("data:")) {
								data += line.slice(5).trim();
							}
						}

						handleSSEEvent(eventName, data);
					}
				}
			};

			const startStream = async () => {
				closeStream();

				clearResults();

				showResults();

				if (rulesEditor) {
					rulesInput.value = rulesEditor.getValue();
				}

				controller = new AbortController();

				const currentController = controller;

				const formData = new FormData(form);

				try {
					const response = await fetch("/analysis/logs", {
						method: "POST",

						body: formData,

						signal: currentController.signal,
					});

					if (!response.ok) {
						const message = await response.text();

						throw new Error(
							"Analysis request failed (" + response.status + "): " + message,
						);
					}

					updateStatus("Analyzing logs...");

					await consumeSSEStream(response);
				} catch (error) {
					if (error.name === "AbortError") {
						return;
					}

					console.error("Analysis stream failed:", error);

					updateStatus(
						error instanceof Error ? error.message : "Analysis stream failed.",
					);
				} finally {
					/*
					 * Do not clear a newer controller
					 * if another analysis was started
					 * before this one finished.
					 */
					if (controller === currentController) {
						controller = null;
					}
				}
			};

			form.addEventListener("submit", (event) => {
				event.preventDefault();

				startStream();
			});

			window.addEventListener("resize", () => {
				scheduleRender(true);
			});

			window.addEventListener("beforeunload", () => {
				closeStream();

				if (rulesEditor) {
					rulesEditor.dispose();
				}
			});
		})();
	</script>
}
