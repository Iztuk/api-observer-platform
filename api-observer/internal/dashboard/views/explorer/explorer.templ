package explorer

import "api-observer/internal/dashboard/views"

type NodeOption struct {
	ID   string
	Name string
}

templ ExplorerPage(
	title string,
	queryString string,
	start string,
	end string,
	nodes []NodeOption,
	selectedNodeID string,
) {
	@views.Layout(title) {
		<link
			rel="stylesheet"
			href="/static/css/explorer.css"
		/>
		@ExplorerPageContent(
			queryString,
			start,
			end,
			nodes,
			selectedNodeID,
		)
		@ExplorerStreamScript()
	}
}

templ ExplorerPageContent(
	queryString string,
	start string,
	end string,
	nodes []NodeOption,
	selectedNodeID string,
) {
	<div class="explorer-page">
		<form
			id="explorer-form"
			class="explorer-form"
			action="/explorer"
			method="get"
		>
			<div class="explorer-search">
				<input
					type="search"
					id="explorer-query"
					name="query"
					value={ queryString }
					placeholder="Search logs..."
					aria-label="Search logs"
				/>
				<button
					type="submit"
					class="explorer-search-button"
					aria-label="Search"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<circle
							cx="11"
							cy="11"
							r="8"
						></circle>
						<line
							x1="21"
							y1="21"
							x2="16.65"
							y2="16.65"
						></line>
					</svg>
					<span>
						Search
					</span>
				</button>
			</div>

			<details class="explorer-advanced">
				<summary>
					<span>
						Advanced Settings
					</span>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="m6 9 6 6 6-6"></path>
					</svg>
				</summary>

				<div class="explorer-filters">
					<div class="explorer-filter">
						<label for="explorer-start">
							Start Date
						</label>
						<input
							type="datetime-local"
							id="explorer-start"
							name="start"
							value={ start }
						/>
					</div>

					<div class="explorer-filter">
						<label for="explorer-end">
							End Date
						</label>
						<input
							type="datetime-local"
							id="explorer-end"
							name="end"
							value={ end }
						/>
					</div>

					<div class="explorer-filter">
						<label for="explorer-node">
							Node
						</label>
						<select
							id="explorer-node"
							name="node"
							disabled?={ len(nodes) == 0 }
						>
							if len(nodes) == 0 {
								<option value="">
									No connected nodes
								</option>
							} else {
								for _, node := range nodes {
									<option
										value={ node.ID }
										selected?={ node.ID == selectedNodeID }
									>
										if node.Name != "" {
											{ node.Name }
										} else {
											{ node.ID }
										}
									</option>
								}
							}
						</select>
					</div>
				</div>
			</details>
		</form>

		<section class="explorer-results">
			<div
				id="explorer-stream-status"
				class="explorer-stream-status"
			>
				if len(nodes) == 0 {
					No connected nodes.
				} else {
					Connecting...
				}
			</div>

			<div
				id="explorer-table-container"
				class="explorer-table-container"
			>
				<table class="explorer-table">
					<thead>
						<tr>
							<th></th>
							<th>Timestamp</th>
							<th>Type</th>
							<th>Method</th>
							<th>Path</th>
							<th>Status</th>
							<th>Findings</th>
						</tr>
					</thead>

					<tbody id="explorer-log-body">
						<tr id="explorer-empty-row">
							<td
								colspan="7"
								class="explorer-empty"
							>
								if len(nodes) == 0 {
									No connected nodes.
								} else {
									Loading logs...
								}
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>
	</div>
}

templ ExplorerStreamScript() {
	<script>
		(() => {
			const form = document.getElementById("explorer-form");
			const body = document.getElementById("explorer-log-body");
			const container = document.getElementById("explorer-table-container");
			const statusElement = document.getElementById("explorer-stream-status");
			const nodeSelect = document.getElementById("explorer-node");

			if (!form || !body || !container) {
				return;
			}

			if (!nodeSelect || !nodeSelect.value) {
				return;
			}

			const params = new URLSearchParams(new FormData(form));

			/*
			 * Measure the total stream time as observed
			 * by the frontend.
			 */
			const streamStartTime = performance.now();

			const source = new EventSource("/logs?" + params.toString());

			const rowHeight = 48;
			const overscan = 20;

			const logs = [];
			const knownLogKeys = new Set();
			const expandedRows = new Set();

			let renderPending = false;
			let forceRenderPending = false;

			let renderedStart = -1;
			let renderedEnd = -1;

			const updateStatus = (message) => {
				if (!statusElement) {
					return;
				}

				statusElement.textContent = message;
			};

			const formatDuration = (milliseconds) => {
				if (milliseconds < 1000) {
					return milliseconds.toFixed(0) + " ms";
				}

				if (milliseconds < 60000) {
					return (milliseconds / 1000).toFixed(2) + " s";
				}

				const minutes = Math.floor(milliseconds / 60000);
				const seconds = (milliseconds % 60000) / 1000;

				return minutes + "m " + seconds.toFixed(2) + "s";
			};

			const logKey = (log) => {
				return [
					log.node_id || "",
					log.request_id || "",
					log.type || "",
					log.timestamp || "",
				].join("|");
			};

			const createCell = (value) => {
				const cell = document.createElement("td");

				if (value !== undefined && value !== null) {
					const text = String(value);

					cell.textContent = text;
					cell.title = text;
				}

				return cell;
			};

			const createDetailField = (label, value) => {
				const field = document.createElement("div");

				field.className = "explorer-detail-field";

				const labelElement = document.createElement("span");

				labelElement.className = "explorer-detail-label";
				labelElement.textContent = label;

				const valueElement = document.createElement("span");

				valueElement.className = "explorer-detail-value";
				valueElement.textContent = value ?? "";

				field.append(labelElement, valueElement);

				return field;
			};

			const createFinding = (finding) => {
				const findingElement = document.createElement("div");

				findingElement.className = "explorer-finding";

				if (finding.severity) {
					findingElement.dataset.severity = finding.severity;
				}

				const fields = document.createElement("div");

				fields.className = "explorer-finding-fields";

				fields.append(
					createDetailField("Title", finding.title || "Finding"),
					createDetailField("Severity", finding.severity || "Unknown"),
					createDetailField("Message", finding.message || ""),
				);

				if (Array.isArray(finding.tags) && finding.tags.length > 0) {
					fields.append(
						createDetailField("Tags", finding.tags.join(", ")),
					);
				}

				findingElement.append(fields);

				return findingElement;
			};

			const createDetailsRow = (log) => {
				const detailsRow = document.createElement("tr");

				detailsRow.className = "explorer-log-details-row";

				const cell = document.createElement("td");

				cell.colSpan = 7;

				const details = document.createElement("div");

				details.className = "explorer-log-details";

				const findings = Array.isArray(log.findings)
					? log.findings
					: [];

				const findingsSection = document.createElement("div");

				findingsSection.className = "explorer-findings";

				const title = document.createElement("div");

				title.className = "explorer-findings-title";
				title.textContent = "Findings (" + findings.length + ")";

				findingsSection.append(title);

				if (findings.length === 0) {
					const empty = document.createElement("div");

					empty.className = "explorer-findings-empty";
					empty.textContent = "No findings for this log.";

					findingsSection.append(empty);
				} else {
					for (const finding of findings) {
						findingsSection.append(createFinding(finding));
					}
				}

				details.append(findingsSection);
				cell.append(details);
				detailsRow.append(cell);

				return detailsRow;
			};

			const createSpacerRow = (height) => {
				const row = document.createElement("tr");

				row.className = "explorer-spacer-row";

				const cell = document.createElement("td");

				cell.colSpan = 7;
				cell.style.height = Math.max(0, height) + "px";

				row.append(cell);

				return row;
			};

			const createLogRow = (log, index) => {
				const findings = Array.isArray(log.findings)
					? log.findings
					: [];

				const key = logKey(log);
				const expanded = expandedRows.has(key);

				const row = document.createElement("tr");

				row.className = "explorer-log-row";
				row.dataset.index = String(index);
				row.dataset.key = key;
				row.tabIndex = 0;

				row.setAttribute("role", "button");
				row.setAttribute("aria-expanded", expanded ? "true" : "false");

				const timestamp = log.timestamp
					? new Date(log.timestamp).toLocaleString()
					: "";

				const toggleCell = document.createElement("td");

				toggleCell.className = "explorer-toggle-cell";

				const toggle = document.createElement("span");

				toggle.className = "explorer-row-toggle";
				toggle.textContent = expanded ? "⌄" : "›";

				toggleCell.append(toggle);

				row.append(
					toggleCell,
					createCell(timestamp),
					createCell(log.type || ""),
					createCell(log.method || ""),
					createCell(log.path || ""),
					createCell(log.status ?? ""),
					createCell(findings.length),
				);

				const toggleDetails = () => {
					if (expandedRows.has(key)) {
						expandedRows.delete(key);
					} else {
						expandedRows.add(key);
					}

					scheduleRender(true);
				};

				row.addEventListener("click", toggleDetails);

				row.addEventListener("keydown", (event) => {
					if (event.key === "Enter" || event.key === " ") {
						event.preventDefault();
						toggleDetails();
					}
				});

				return row;
			};

			const getRenderWindow = () => {
				const scrollTop = container.scrollTop;
				const viewportHeight = container.clientHeight;
				const visibleStart = Math.floor(scrollTop / rowHeight);
				const visibleCount = Math.ceil(viewportHeight / rowHeight);
				const startIndex = Math.max(0, visibleStart - overscan);

				const endIndex = Math.min(
					logs.length,
					visibleStart + visibleCount + overscan,
				);

				return {
					startIndex,
					endIndex,
				};
			};

			const updateSpacerHeights = (startIndex, endIndex) => {
				const topSpacer = body.querySelector(
					".explorer-spacer-row[data-position='top']",
				);

				const bottomSpacer = body.querySelector(
					".explorer-spacer-row[data-position='bottom']",
				);

				const topHeight = startIndex * rowHeight;
				const bottomHeight = Math.max(
					0,
					(logs.length - endIndex) * rowHeight,
				);

				if (topSpacer && topSpacer.firstElementChild) {
					topSpacer.firstElementChild.style.height =
						Math.max(0, topHeight) + "px";
				}

				if (bottomSpacer && bottomSpacer.firstElementChild) {
					bottomSpacer.firstElementChild.style.height =
						Math.max(0, bottomHeight) + "px";
				}
			};

			const render = (force = false) => {
				renderPending = false;

				if (logs.length === 0) {
					return;
				}

				const { startIndex, endIndex } = getRenderWindow();

				if (
					!force &&
					startIndex === renderedStart &&
					endIndex === renderedEnd
				) {
					updateSpacerHeights(startIndex, endIndex);
					return;
				}

				const topHeight = startIndex * rowHeight;
				const bottomHeight = Math.max(
					0,
					(logs.length - endIndex) * rowHeight,
				);

				const fragment = document.createDocumentFragment();

				const topSpacer = createSpacerRow(topHeight);

				topSpacer.dataset.position = "top";

				fragment.append(topSpacer);

				for (let index = startIndex; index < endIndex; index++) {
					const log = logs[index];

					fragment.append(createLogRow(log, index));

					if (expandedRows.has(logKey(log))) {
						fragment.append(createDetailsRow(log));
					}
				}

				const bottomSpacer = createSpacerRow(bottomHeight);

				bottomSpacer.dataset.position = "bottom";

				fragment.append(bottomSpacer);

				body.replaceChildren(fragment);

				renderedStart = startIndex;
				renderedEnd = endIndex;
			};

			const scheduleRender = (force = false) => {
				if (force) {
					forceRenderPending = true;
				}

				if (renderPending) {
					return;
				}

				renderPending = true;

				requestAnimationFrame(() => {
					const shouldForce = forceRenderPending;

					forceRenderPending = false;

					render(shouldForce);
				});
			};

			container.addEventListener(
				"scroll",
				() => {
					scheduleRender();
				},
				{
					passive: true,
				},
			);

			window.addEventListener("resize", () => {
				scheduleRender(true);
			});

			source.addEventListener("open", () => {
				const selectedOption =
					nodeSelect.options[nodeSelect.selectedIndex];

				const nodeName = selectedOption
					? selectedOption.textContent.trim()
					: nodeSelect.value;

				updateStatus("Streaming logs from " + nodeName + "...");
			});

			source.addEventListener("logs", (event) => {
				let incoming;

				try {
					incoming = JSON.parse(event.data);
				} catch (error) {
					console.error("Failed to parse Explorer logs:", error);
					return;
				}

				if (!Array.isArray(incoming)) {
					console.error("Invalid Explorer logs payload:", incoming);
					return;
				}

				const uniqueIncoming = [];

				for (const log of incoming) {
					const key = logKey(log);

					if (knownLogKeys.has(key)) {
						continue;
					}

					knownLogKeys.add(key);
					uniqueIncoming.push(log);
				}

				if (uniqueIncoming.length === 0) {
					return;
				}

				logs.push(...uniqueIncoming);

				scheduleRender();

				updateStatus(
					"Streaming logs — " +
						logs.length +
						" matches",
				);
			});

			source.addEventListener("node_done", () => {
				updateStatus(
					"Finishing stream — " +
						logs.length +
						" matches",
				);
			});

			source.addEventListener("node_error", (event) => {
				let result;

				try {
					result = JSON.parse(event.data);
				} catch (error) {
					console.error("Failed to parse node error:", error);
					return;
				}

				console.error(
					"Collector stream failed:",
					result.node_name || result.node_id,
					result.message,
				);

				updateStatus(
					"Node stream error — " +
						result.message,
				);
			});

			source.addEventListener("done", (event) => {
				let result;

				try {
					result = JSON.parse(event.data);
				} catch (error) {
					console.error("Failed to parse done event:", error);

					source.close();

					return;
				}

				const streamEndTime = performance.now();
				const totalStreamTime = streamEndTime - streamStartTime;

				source.close();

				if (logs.length === 0) {
					const row = document.createElement("tr");

					row.id = "explorer-empty-row";

					const cell = document.createElement("td");

					cell.colSpan = 7;
					cell.className = "explorer-empty";
					cell.textContent = "No logs found.";

					row.append(cell);
					body.replaceChildren(row);

					renderedStart = -1;
					renderedEnd = -1;
				} else {
					scheduleRender(true);
				}

				if (result.failed_nodes > 0) {
					updateStatus(
						"Stream failed — " +
							result.matches +
							" matches loaded in " +
							formatDuration(totalStreamTime),
					);

					return;
				}

				updateStatus(
					"Complete — " +
						result.matches +
						" matches in " +
						formatDuration(totalStreamTime),
				);
			});

			source.onerror = () => {
				if (source.readyState === EventSource.CLOSED) {
					return;
				}

				if (source.readyState === EventSource.CONNECTING) {
					updateStatus(
						"Explorer stream disconnected — reconnecting...",
					);

					return;
				}

				updateStatus("Explorer stream connection error.");
			};

			window.addEventListener("beforeunload", () => {
				source.close();
			});
		})();
	</script>
}
