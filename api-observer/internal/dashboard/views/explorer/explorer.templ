package explorer

import (
	"api-observer/internal/dashboard/views"
	"api-observer/internal/nodes"
	"api-observer/internal/query"
	queryv1 "api-observer/proto/query/v1"
	"fmt"
	"time"
)

templ ExplorerPage(
	title string,
	queryString string,
	start string,
	end string,
	selectedNode string,
	limit string,
	nodeList []*nodes.Node,
	logs []query.LogItem,
	nextCursor int64,
	hasMore bool,
) {
	@views.Layout(title) {
		<link rel="stylesheet" href="/static/css/explorer.css"/>
		@ExplorerPageContent(
			queryString,
			start,
			end,
			selectedNode,
			limit,
			nodeList,
			logs,
			nextCursor,
			hasMore,
		)
	}
}

templ ExplorerPageContent(
	queryString string,
	start string,
	end string,
	selectedNode string,
	limit string,
	nodeList []*nodes.Node,
	logs []query.LogItem,
	nextCursor int64,
	hasMore bool,
) {
	<div class="explorer-page">
		<form
			id="explorer-form"
			class="explorer-form"
			action="/explorer"
			method="get"
		>
			<div class="explorer-search">
				<input
					type="search"
					id="explorer-query"
					name="query"
					value={ queryString } placeholder="Search logs..." aria-label="Search logs" />
				<button
					type="submit"
					class="explorer-search-button"
					aria-label="Search"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<circle cx="11" cy="11" r="8"></circle>
						<line
							x1="21"
							y1="21"
							x2="16.65"
							y2="16.65"
						></line>
					</svg>
					<span>
						Search
					</span>
				</button>
			</div>

			<details class="explorer-advanced">
				<summary>
					<span>
						Advanced Settings
					</span>

					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="m6 9 6 6 6-6"></path>
					</svg>
				</summary>

				<div class="explorer-filters">
					<div class="explorer-filter">
						<label for="explorer-start">
							Start Date
						</label>

						<input
							type="datetime-local"
							id="explorer-start"
							name="start"
							value={ start }
						/>
					</div>

					<div class="explorer-filter">
						<label for="explorer-end">
							End Date
						</label>

						<input
							type="datetime-local"
							id="explorer-end"
							name="end"
							value={ end }
						/>
					</div>

					<div class="explorer-filter">
						<label for="explorer-node">
							Node
						</label>

						<select
							id="explorer-node"
							name="node"
						>
							<option value="">
								Select a node
							</option>

							for _, node := range nodeList {
								<option
									value={ node.ID }
									selected?={ node.ID == selectedNode }
								>
									{ node.Name }
								</option>
							}
						</select>
					</div>

					<div class="explorer-filter">
						<label for="explorer-limit">
							Limit
						</label>

						<select
							id="explorer-limit"
							name="limit"
						>
							<option
								value="50"
								selected?={ limit == "50" }
							>
								50
							</option>

							<option
								value="100"
								selected?={ limit == "100" }
							>
								100
							</option>

							<option
								value="250"
								selected?={ limit == "250" }
							>
								250
							</option>

							<option
								value="500"
								selected?={ limit == "500" }
							>
								500
							</option>
						</select>
					</div>
				</div>
			</details>
		</form>

		<section class="explorer-results">
			<div class="explorer-table-container">
				<table class="explorer-table">
					<thead>
						<tr>
							<th>Timestamp</th>
							<th>Type</th>
							<th>Method</th>
							<th>Path</th>
							<th>Status</th>
                            <th>Findings</th>
						</tr>
					</thead>

					<tbody id="explorer-log-body">
						if selectedNode == "" {
							<tr>
								<td
									colspan="5"
									class="explorer-empty"
								>
									Select a node and run a search.
								</td>
							</tr>
						} else {
							@ExplorerLogRows(
								logs,
								nextCursor,
								hasMore,
							)
						}
					</tbody>
				</table>
			</div>
		</section>
	</div>
}

templ ExplorerLogRows(
	logs []query.LogItem,
	nextCursor int64,
	hasMore bool,
) {
	if len(logs) == 0 {
		<tr>
			<td
				colspan="5"
				class="explorer-empty"
			>
				No logs found.
			</td>
		</tr>
	} else {
		for i, log := range logs {
			@ExplorerLogRow(
				log,
				i == len(logs)-1,
				nextCursor,
				hasMore,
			)
		}

		if !hasMore {
			<tr>
				<td
					colspan="5"
					class="explorer-empty"
				>
					End of logs
				</td>
			</tr>
		}
	}
}

templ ExplorerLogRow(
	log query.LogItem,
	isLast bool,
	nextCursor int64,
	hasMore bool,
) {
	if log.Log != nil {
		switch event := log.Log.Event.(type) {
			case *queryv1.Log_Request:
				if event.Request != nil {
					if isLast && hasMore {
						<tr
							class="explorer-log-row"
							hx-get="/logs"
							hx-trigger="revealed once"
							hx-target="this"
							hx-swap="afterend"
							hx-include="#explorer-form"
							hx-vals={ fmt.Sprintf(
								`{"cursor":"%d"}`,
								nextCursor,
							) }
						>
							@ExplorerRequestColumns(
								event.Request,
							)
						</tr>
					} else {
						<tr class="explorer-log-row">
							@ExplorerRequestColumns(
								event.Request,
							)
						</tr>
					}
				}

			case *queryv1.Log_Response:
				if event.Response != nil {
					if isLast && hasMore {
						<tr
							class="explorer-log-row"
							hx-get="/logs"
							hx-trigger="revealed once"
							hx-target="this"
							hx-swap="afterend"
							hx-include="#explorer-form"
							hx-vals={ fmt.Sprintf(
								`{"cursor":"%d"}`,
								nextCursor,
							) }
						>
							@ExplorerResponseColumns(
								event.Response,
							)
						</tr>
					} else {
						<tr class="explorer-log-row">
							@ExplorerResponseColumns(
								event.Response,
							)
						</tr>
					}
				}
		}
	}
}

templ ExplorerRequestColumns(
	request *queryv1.Request,
) {
	<td>
		if request.Metadata != nil &&
			request.Metadata.Timestamp != nil {
			{
				request.Metadata.Timestamp.
					AsTime().
					In(time.Local).
					Format("2006-01-02 15:04:05")
			}
		}
	</td>

	<td>
		Request
	</td>

	<td>
		{ request.Method }
	</td>

	<td>
		{ request.Url }
	</td>

	<td></td>

    <td></td>
}

templ ExplorerResponseColumns(
	response *queryv1.Response,
) {
	<td>
		if response.Metadata != nil &&
			response.Metadata.Timestamp != nil {
			{
				response.Metadata.Timestamp.
					AsTime().
					In(time.Local).
					Format("2006-01-02 15:04:05")
			}
		}
	</td>

	<td>
		Response
	</td>

	<td></td>

	<td></td>

	<td>
		{
			fmt.Sprintf(
				"%d",
				response.StatusCode,
			)
		}
	</td>
    <td></td>
}
