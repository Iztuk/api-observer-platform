package rules

import "api-observer/internal/dashboard/views"

templ RulesImportPage(title string) {
	@views.Layout(title) {
		<link rel="stylesheet" href="/static/css/rules-import.css"/>
		@RulesImportPageContent()
		<link rel="stylesheet" href="/static/js/monaco.css"/>
		<script type="module" src="/static/js/monaco.js"></script>
		<script type="module" src="/static/js/rule-imports.js"></script>
	}
}

templ RulesImportPageContent() {
	<div class="rules-import-page">
		<header class="rules-import-header">
			<a href="/rules" class="back-to-rules">← Back to Rules</a>
			<h2>Import Rules</h2>
		</header>
		<div class="editors">
			<section>
				@RuleImportEditor("src", "plaintext")
			</section>
			<section>
				@RuleImportEditor("result", "yaml")
			</section>
		</div>
		<footer class="rules-import-actions">
			<select name="rule-type" id="rule-type-selector">
				<option value="crs">Core Rule Set (CRS)</option>
			</select>
			<button type="button" id="translate-button" class="translate-button">
				<span class="translate-button__label">Translate Rule</span>
				<span class="translate-button__spinner" aria-hidden="true"></span>
			</button>
		</footer>
	</div>
}

templ RuleImportEditor(id, language string) {
	<div
		id={ id }
		class="api-observer-editor"
		data-language={ language }
	></div>
}
