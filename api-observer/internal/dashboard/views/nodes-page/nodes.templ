package nodespage

import (
	"api-observer/internal/dashboard/views"
	"api-observer/internal/nodes"
	"fmt"
)

templ NodesPage(title string, nodes []*nodes.Node) {
	@views.Layout(title) {
		<link rel="stylesheet" href="/static/css/nodes.css"/>
		@NodesPageContent(nodes)
		@AddNodeModal()
		@DeleteNodeModal()
		@FormValidationScript()
		@DeleteNodeModalScript()
	}
}

templ NodesPageContent(nodes []*nodes.Node) {
	<div class="nodes-page">
		<header class="nodes-page-header">
			<h2>Nodes</h2>
			<p>
				Review the nodes registered to API Observer
			</p>
		</header>
		<section class="nodes-section nodes-actions">
			<button
				type="button"
				onclick="document.getElementById('addNodeModal').showModal()"
			>
				Add Node
			</button>
			<button
				type="button"
				onclick="
					populateDeleteNodeDropdown();
					document.getElementById('deleteNodeModal').showModal();
				"
			>
				Delete Node
			</button>
		</section>
		<section
			id="nodes-section"
			class="nodes-section"
		>
			@NodesList(nodes)
		</section>
	</div>
}

templ NodesList(nodes []*nodes.Node) {
	<div class="nodes-list-header">
		<h3>Registered Nodes</h3>
		<span class="rules-count">
			{ fmt.Sprintf("%d nodes", len(nodes)) }
		</span>
	</div>
	<div
		class="nodes-workspace"
		id="nodes-workspace"
	>
		<div
			id="nodes-list"
			class="nodes-list"
		>
			if len(nodes) == 0 {
				<div class="nodes-empty">
					<p>
						No nodes currently registered.
					</p>
				</div>
			} else {
				for _, node := range nodes {
					<div
						class="node-item"
						data-node-id={ node.ID }
						data-node-name={ node.Name }
					>
						<p class="node-name">
							{ node.Name }
						</p>
						<p class="node-id">
							{ node.ID }
						</p>
						<p class="node-addr">
							{ node.Addr }
						</p>
					</div>
				}
			}
		</div>
	</div>
}

templ AddNodeModal() {
	<dialog
		id="addNodeModal"
		class="modal"
	>
		<form
			id="add-node-form"
			class="modal-form"
			data-validate-form
			hx-post="/nodes"
			hx-target="#nodes-section"
			hx-swap="innerHTML"
			hx-on::after:request="
				document.getElementById('addNodeModal').close();
			"
		>
			<header>
				<h2>Add Node</h2>
			</header>
			<div class="modal-form-field">
				<label for="add-node-name">
					Name
				</label>
				<input
					type="text"
					name="name"
					id="add-node-name"
					required
				/>
			</div>
			<div class="modal-form-field">
				<label for="add-node-addr">
					Address
				</label>
				<input
					type="text"
					name="addr"
					id="add-node-addr"
					required
				/>
			</div>
			<div>
				<button
					type="submit"
					data-submit-button
					disabled
				>
					Add
				</button>
				<button
					type="button"
					onclick="document.getElementById('addNodeModal').close()"
				>
					Cancel
				</button>
			</div>
		</form>
	</dialog>
}

templ DeleteNodeModal() {
	<dialog
		id="deleteNodeModal"
		class="modal"
	>
		<form
			id="delete-node-form"
			class="modal-form"
			data-validate-form
			hx-delete="/nodes"
			hx-target="#nodes-section"
			hx-swap="innerHTML"
			hx-on::after:request="
				document.getElementById('deleteNodeModal').close();
			"
		>
			<header>
				<h2>Delete Node</h2>
			</header>
			<div class="modal-form-field">
				<label for="delete-node-dropdown">
					Node
				</label>
				<select
					name="delete-node-id"
					id="delete-node-dropdown"
					required
				>
					<option value="">
						Select Node
					</option>
				</select>
			</div>
			<div>
				<button
					type="submit"
					data-submit-button
					disabled
				>
					Delete
				</button>
				<button
					type="button"
					onclick="document.getElementById('deleteNodeModal').close()"
				>
					Cancel
				</button>
			</div>
		</form>
	</dialog>
}

templ FormValidationScript() {
	<script>
		(() => {
			const forms = document.querySelectorAll("[data-validate-form]");

			forms.forEach((form) => {
				const submitButton = form.querySelector("[data-submit-button]");

				if (!submitButton) {
					return;
				}

				const checkValidity = () => {
					submitButton.disabled = !form.checkValidity();
				};

				form.addEventListener("input", checkValidity);

				form.addEventListener("change", checkValidity);

				form.addEventListener("reset", () => {
					requestAnimationFrame(checkValidity);
				});

				checkValidity();
			});
		})();
	</script>
}

templ DeleteNodeModalScript() {
	<script>
		function populateDeleteNodeDropdown() {
			const nodesList = document.getElementById("nodes-list");

			const dropdown = document.getElementById("delete-node-dropdown");

			if (!nodesList || !dropdown) {
				return;
			}

			/*
				Clear any nodes that were previously added to
				the dropdown.

				This prevents duplicates every time the modal
				is opened.
			*/
			dropdown.innerHTML = "";

			const placeholder = document.createElement("option");

			placeholder.value = "";
			placeholder.textContent = "Select Node";

			dropdown.append(placeholder);

			/*
				Read the current node list.

				This is important because #nodes-list may have
				been replaced by HTMX since the last time the
				dialog was opened.
			*/
			const nodes = nodesList.querySelectorAll(
				"[data-node-id]",
				"[data-node-name]",
			);

			nodes.forEach((node) => {
				const id = node.dataset.nodeId;
				const name = node.dataset.nodeName;

				if (!name) {
					return;
				}

				const option = document.createElement("option");

				option.value = id;
				option.textContent = name;

				dropdown.append(option);
			});

			/*
				The dropdown may have changed from a valid
				value back to the empty placeholder, so fire
				a change event to update form validation.
			*/
			dropdown.dispatchEvent(
				new Event("change", {
					bubbles: true,
				}),
			);
		}
	</script>
}
